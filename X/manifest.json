{
  "manifest_version": 3,
  "name": "X (Twitter) Engagement Tracker",
  "version": "1.0.0",
  "description": "Passively collects likes, comments, reposts, text, and media type from posts as you scroll on X/Twitter, then exports everything to an Excel file.",
  "permissions": ["storage", "unlimitedStorage", "downloads", "scripting", "activeTab"],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Engagement Tracker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
